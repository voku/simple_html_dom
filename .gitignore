# Created by http://www.gitignore.io

# php (composer)
vendor
composer.lock

# the isolated tool projects pin their own dependencies
!/tools/*/composer.lock

# agent-loop governed workflow (see AGENTS.md)
# durable state - board, tasks, contracts, run receipts, learning - is committed;
# navigation, recall and session working memory are regenerated on demand.
/.agent-map/
/.agent-loop/map/
/.agent-loop/recall/
/.agent-loop/sessions/
/.agent-loop/edit/
/.agent-loop/tool-inventory.json
# generated client projections of the package-owned agent assets;
# recreate them with "php bin/agent-loop init install-assets --agent=all"
/.claude/
/.codex/
/.agents/
/.github/skills/
/.github/agents/

# php (phpunit)
build/logs/
.phpunit.result.cache

# php (phpcs fixer)
.php_cs.cache

### PhpStorm ###
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm

## Directory-based project format
.idea/
# if you remove the above rule, at least ignore user-specific stuff:
# .idea/workspace.xml
# .idea/tasks.xml
# and these sensitive or high-churn files:
# .idea/dataSources.ids
# .idea/dataSources.xml
# .idea/sqlDataSources.xml
# .idea/dynamic.xml

## File-based project format
*.ipr
*.iws
*.iml

